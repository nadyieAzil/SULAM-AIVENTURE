# ==========================================
# AI MathMentor Environment Configuration
# Copy this file to .env and fill in real values.
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==========================================

# --- LLM Provider (M2) ---
# OpenAI-compatible API base URL, e.g.:
# - Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# - Groq: https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-api-key-here
LLM_MODEL=qwen/qwen3.7-flash
EMBED_MODEL=openai/text-embedding-3-small

# --- Supabase Database & Auth (M1, M3, M4) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=your-optional-legacy-jwt-secret

# --- Authentication & Rate Limiting (M1, M4) ---
# Set to false for local dev (allows guest requests without token)
AUTH_REQUIRED=false
RATE_LIMIT_PER_MIN=8
RATE_LIMIT_PER_DAY=120

# --- Server & CORS (M4) ---
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

